NODE_ENV=development
PORT=3001
API_PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=51mai_app
DB_PASSWORD=
DB_NAME=51mai_app
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=5000
TRUST_PROXY=false
ALLOWED_ORIGIN=http://127.0.0.1:3000
AUTH_HMAC_KEY=
SESSION_COOKIE_NAME=51mai_session
SESSION_TTL_SECONDS=86400
REMEMBER_SESSION_TTL_SECONDS=604800
STATIC_DIR=dist
INDEX_FILE=dist/index.html
# Set this only for an explicit local migration run when the compiled SQL is elsewhere.
# MIGRATIONS_DIR=server/db/migrations

# Order lifecycle
ORDER_EXPIRY_SWEEP_SECONDS=60

# Fulfillment encryption (base64url-encoded 32-byte key; keep empty until configured)
FULFILLMENT_ENCRYPTION_KEY=

# WeChat Pay API v3 callback verification
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PEM=

# WeChat Native payment creation
WECHAT_PAY_APP_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PEM=
WECHAT_PAY_NOTIFY_URL=

# Alipay callback verification and precreate payment
ALIPAY_APP_ID=
ALIPAY_PUBLIC_KEY_PEM=
ALIPAY_MERCHANT_PRIVATE_KEY_PEM=
ALIPAY_NOTIFY_URL=

# Read-only supplier protocol evidence manifest. Do not point this at an unverified guessed API contract.
SUPPLIER_PROTOCOL_MANIFEST=
