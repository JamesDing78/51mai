{
  "name": "51mai-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:frontend": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json && mkdir -p dist-server/server/db/migrations && cp server/db/migrations/*.sql dist-server/server/db/migrations/",
    "build": "npm run build:frontend && npm run build:server",
    "test": "vitest run",
    "test:backend": "VITEST_BACKEND=1 vitest run server",
    "test:watch": "vitest",
    "typecheck:frontend": "tsc -b --pretty false",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit --pretty false",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:server",
    "migrate": "npm run build:server && node dist-server/server/db/migrate.js",
    "create-admin": "npm run build:server && node dist-server/server/scripts/create-admin.js",
    "cleanup:login-logs": "npm run build:server && node dist-server/server/scripts/cleanup-login-logs.js",
    "start": "node dist-server/server/main.js",
    "start:prod": "npm run build && node dist-server/server/main.js",
    "payment:preflight": "npm run build:server && node dist-server/server/scripts/payment-preflight.js",
    "supplier:preflight": "npm run build:server && node dist-server/server/scripts/supplier-preflight.js"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  }
}
